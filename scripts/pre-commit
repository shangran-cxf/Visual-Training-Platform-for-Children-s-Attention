#!/usr/bin/env bash
# Pre-commit hook: 检查代码格式是否符合规范

set -e

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

CHANGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
CHANGED_FRONTEND=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(html|css|js|json)$' | grep '^frontend/' || true)

EXIT_CODE=0

# ===== Python: Ruff =====
if [ -n "$CHANGED_PY" ]; then
    echo -e "${YELLOW}[Ruff] 检查 Python 文件...${NC}"

    # 格式化检查
    if ! ruff format --check $CHANGED_PY 2>/dev/null; then
        echo -e "${RED}[Ruff] 格式化不一致，请运行: ruff format${NC}"
        EXIT_CODE=1
    fi

    # Lint 检查
    if ! ruff check $CHANGED_PY 2>/dev/null; then
        echo -e "${RED}[Ruff] Lint 检查未通过，请运行: ruff check --fix${NC}"
        EXIT_CODE=1
    fi

    if [ $EXIT_CODE -eq 0 ]; then
        echo -e "${GREEN}[Ruff] 通过${NC}"
    fi
fi

# ===== Frontend: Prettier =====
if [ -n "$CHANGED_FRONTEND" ]; then
    echo -e "${YELLOW}[Prettier] 检查前端文件...${NC}"

    if ! npx prettier --check $CHANGED_FRONTEND 2>/dev/null; then
        echo -e "${RED}[Prettier] 格式化不一致，请运行: npx prettier --write <files>${NC}"
        EXIT_CODE=1
    else
        echo -e "${GREEN}[Prettier] 通过${NC}"
    fi
fi

if [ $EXIT_CODE -eq 0 ]; then
    echo -e "${GREEN}所有格式检查通过${NC}"
else
    echo -e "${RED}格式检查失败，请修复后重新提交${NC}"
fi

exit $EXIT_CODE
